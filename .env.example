# Environment variables for Scoutboard

# Backend Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True
DATABASE_URL=sqlite:///./scoutboard.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql+psycopg2://scout:scoutpassword@localhost:5432/scoutboard

# Security
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-scoutboard
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Optional AI Configuration (Free-first / local by default)
# AI_PROVIDER: local, ollama, openai_compatible
AI_PROVIDER=local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_MODEL=gpt-4o-mini

# Optional Connectors API Tokens (not required for public rates)
GITHUB_API_TOKEN=

# SSRF Protection
ALLOW_PRIVATE_IPS=False
